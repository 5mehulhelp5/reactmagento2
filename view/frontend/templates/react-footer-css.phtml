<script>
// Comprehensive Accessibility Fix for Customer Menu
//TODO: Move to a separate file and relise on .phtml template level
document.addEventListener('DOMContentLoaded', function() {
    // Function to update menu accessibility state
    function updateMenuAccessibility(menu, isVisible) {
        menu.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
        menu.setAttribute('role', 'menu');
        
        // Fix menu structure - add required child roles
        // ul elements inside menu should have role="none" or "presentation"
        var ulElements = menu.querySelectorAll('ul');
        ulElements.forEach(function(ul) {
            if (!ul.getAttribute('role')) {
                ul.setAttribute('role', 'none');
            }
        });
        
        // li elements inside menu should have role="none" or "presentation"
        var liElements = menu.querySelectorAll('li');
        liElements.forEach(function(li) {
            if (!li.getAttribute('role')) {
                li.setAttribute('role', 'none');
            }
        });
        
        // Links inside menu should have role="menuitem"
        var links = menu.querySelectorAll('a');
        links.forEach(function(link) {
            if (!link.getAttribute('role')) {
                link.setAttribute('role', 'menuitem');
            }
            if (isVisible) {
                link.removeAttribute('tabindex');
            } else {
                link.setAttribute('tabindex', '-1');
            }
        });
    }
    
    // Function to fix menu structure with required child roles
    function fixMenuStructure(menu) {
        if (!menu) return;
        
        // Ensure menu has role="menu"
        if (!menu.getAttribute('role')) {
            menu.setAttribute('role', 'menu');
        }
        
        // ul elements should have role="none" (they're just structural)
        var ulElements = menu.querySelectorAll('ul');
        ulElements.forEach(function(ul) {
            if (!ul.getAttribute('role')) {
                ul.setAttribute('role', 'none');
            }
        });
        
        // li elements should have role="none" (they're just structural)
        var liElements = menu.querySelectorAll('li');
        liElements.forEach(function(li) {
            if (!li.getAttribute('role')) {
                li.setAttribute('role', 'none');
            }
        });
        
        // Links should have role="menuitem" (required children of menu)
        var links = menu.querySelectorAll('a');
        links.forEach(function(link) {
            if (!link.getAttribute('role')) {
                link.setAttribute('role', 'menuitem');
            }
        });
    }
    
    // Find all customer-menu elements
    var customerMenus = document.querySelectorAll('.customer-menu[data-target="dropdown"]');
    customerMenus.forEach(function(customerMenu) {
        // Fix menu structure first
        fixMenuStructure(customerMenu);
        // Check if menu is initially visible (not hidden by CSS)
        var isVisible = customerMenu.offsetParent !== null && 
                       window.getComputedStyle(customerMenu).display !== 'none';
        
        // Set initial state
        updateMenuAccessibility(customerMenu, isVisible);
        
        // Find associated trigger
        var customerTrigger = customerMenu.previousElementSibling || 
                             customerMenu.parentNode.querySelector('.customer-name[data-toggle="dropdown"]') ||
                             customerMenu.parentNode.querySelector('[data-toggle="dropdown"]') ||
                             customerMenu.closest('.customer-welcome')?.querySelector('.customer-name');
        
        if (customerTrigger) {
            // Set trigger attributes
            customerTrigger.setAttribute('aria-expanded', isVisible ? 'true' : 'false');
            customerTrigger.setAttribute('aria-haspopup', 'true');
            if (!customerTrigger.getAttribute('role')) {
                customerTrigger.setAttribute('role', 'button');
            }
            
            // Handle toggle
            function toggleMenu() {
                var isExpanded = customerTrigger.getAttribute('aria-expanded') === 'true';
                customerTrigger.setAttribute('aria-expanded', !isExpanded);
                updateMenuAccessibility(customerMenu, !isExpanded);
            }
            
            customerTrigger.addEventListener('click', toggleMenu);
            customerTrigger.addEventListener('keydown', function(e) {
                if (e.keyCode === 13 || e.keyCode === 32) {
                    e.preventDefault();
                    toggleMenu();
                }
            });
            
            // Close on escape
            document.addEventListener('keydown', function(e) {
                if (e.keyCode === 27 && customerMenu.getAttribute('aria-hidden') === 'false') {
                    customerTrigger.setAttribute('aria-expanded', 'false');
                    updateMenuAccessibility(customerMenu, false);
                    customerTrigger.focus();
                }
            });
            
            // Close on click outside
            document.addEventListener('click', function(e) {
                if (!customerTrigger.contains(e.target) && !customerMenu.contains(e.target)) {
                    customerTrigger.setAttribute('aria-expanded', 'false');
                    updateMenuAccessibility(customerMenu, false);
                }
            });
        } else {
            // No trigger found - menu should be visible (not hidden)
            updateMenuAccessibility(customerMenu, true);
        }
    });
    
    // Use MutationObserver to watch for menu visibility changes
    var menuObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'aria-hidden') {
                var menu = mutation.target;
                var isVisible = menu.getAttribute('aria-hidden') === 'false';
                var links = menu.querySelectorAll('a');
                links.forEach(function(link) {
                    if (isVisible) {
                        link.removeAttribute('tabindex');
                    } else {
                        link.setAttribute('tabindex', '-1');
                    }
                });
            }
        });
    });
    
    customerMenus.forEach(function(menu) {
        menuObserver.observe(menu, {
            attributes: true,
            attributeFilter: ['aria-hidden']
        });
    });
    
    // Use MutationObserver to fix menu structure for dynamically added menus
    var menuStructureObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                    // Check if added node is a customer-menu
                    if (node.classList && node.classList.contains('customer-menu')) {
                        fixMenuStructure(node);
                        updateMenuAccessibility(node, node.offsetParent !== null);
                    }
                    // Check for customer-menu inside added nodes
                    var newMenus = node.querySelectorAll && node.querySelectorAll('.customer-menu[data-target="dropdown"]');
                    if (newMenus) {
                        newMenus.forEach(function(menu) {
                            fixMenuStructure(menu);
                            updateMenuAccessibility(menu, menu.offsetParent !== null);
                        });
                    }
                }
            });
        });
    });
    
    menuStructureObserver.observe(document.body, {
        childList: true,
        subtree: true
    });
    
    // Make action links non-crawlable for SEO
    // Fix showcart links
    var showcartLinks = document.querySelectorAll('a.action.showcart');
    showcartLinks.forEach(function(link) {
        link.setAttribute('rel', 'nofollow noindex');
        link.setAttribute('data-noindex', 'true');
        if (!link.getAttribute('href') || link.getAttribute('href') !== '#') {
            link.setAttribute('href', '#');
        }
    });
    
    // Fix compare links (including no-display variants)
    var compareLinks = document.querySelectorAll('a.action.compare, a.action.compare.no-display, a.action.tocompare');
    compareLinks.forEach(function(link) {
        link.setAttribute('rel', 'nofollow noindex');
        link.setAttribute('data-noindex', 'true');
        if (!link.getAttribute('href') || link.getAttribute('href') !== '#') {
            link.setAttribute('href', '#');
        }
    });
    
    // Use MutationObserver to handle dynamically added action links
    var linkObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                    // Check if added node is a showcart or compare link
                    if (node.tagName === 'A' && 
                        (node.classList.contains('action') && 
                         (node.classList.contains('showcart') || 
                          node.classList.contains('compare') || 
                          node.classList.contains('tocompare')))) {
                        node.setAttribute('rel', 'nofollow noindex');
                        node.setAttribute('data-noindex', 'true');
                        if (!node.getAttribute('href') || node.getAttribute('href') !== '#') {
                            node.setAttribute('href', '#');
                        }
                    }
                    // Check for links inside added nodes
                    var newLinks = node.querySelectorAll && node.querySelectorAll('a.action.showcart, a.action.compare, a.action.compare.no-display, a.action.tocompare');
                    if (newLinks) {
                        newLinks.forEach(function(link) {
                            link.setAttribute('rel', 'nofollow noindex');
                            link.setAttribute('data-noindex', 'true');
                            if (!link.getAttribute('href') || link.getAttribute('href') !== '#') {
                                link.setAttribute('href', '#');
                            }
                        });
                    }
                }
            });
        });
    });
    
    linkObserver.observe(document.body, {
        childList: true,
        subtree: true
    });
    
    // Fix prohibited ARIA attributes - add proper role to elements with aria-labelledby
    function fixProhibitedAriaAttributes() {
        // Find elements with aria-labelledby but no role
        var elementsWithAriaLabelledby = document.querySelectorAll('[aria-labelledby]:not([role])');
        elementsWithAriaLabelledby.forEach(function(element) {
            // Add appropriate role based on element type and context
            if (element.classList.contains('block-content') || element.classList.contains('content')) {
                // Content blocks should have role="region"
                element.setAttribute('role', 'region');
            } else if (element.tagName === 'DIV' && element.getAttribute('aria-labelledby')) {
                // Generic divs with aria-labelledby should have role="region"
                element.setAttribute('role', 'region');
            }
        });
        
        // Also check for dynamically added elements
        var allElements = document.querySelectorAll('[aria-labelledby]');
        allElements.forEach(function(element) {
            if (!element.getAttribute('role')) {
                // Check if it's a content block
                if (element.classList.contains('block-content') || 
                    element.classList.contains('content') ||
                    element.classList.contains('filter-content')) {
                    element.setAttribute('role', 'region');
                } else if (element.tagName === 'DIV') {
                    // Generic divs should have role="region" when using aria-labelledby
                    element.setAttribute('role', 'region');
                }
            }
        });
    }
    
    // Run on DOM ready
    fixProhibitedAriaAttributes();
    
    // Also run after page load
    window.addEventListener('load', fixProhibitedAriaAttributes);
    
    // Use MutationObserver to handle dynamically added elements
    var ariaObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                    // Check if added node has aria-labelledby without role
                    if (node.hasAttribute && node.hasAttribute('aria-labelledby') && !node.getAttribute('role')) {
                        if (node.classList && (node.classList.contains('block-content') || 
                            node.classList.contains('content'))) {
                            node.setAttribute('role', 'region');
                        } else if (node.tagName === 'DIV') {
                            node.setAttribute('role', 'region');
                        }
                    }
                    // Check for elements inside added nodes
                    var newElements = node.querySelectorAll && node.querySelectorAll('[aria-labelledby]:not([role])');
                    if (newElements) {
                        newElements.forEach(function(el) {
                            if (el.classList.contains('block-content') || 
                                el.classList.contains('content') ||
                                el.tagName === 'DIV') {
                                el.setAttribute('role', 'region');
                            }
                        });
                    }
                }
            });
        });
    });
    
    ariaObserver.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['aria-labelledby']
    });
});
</script>
