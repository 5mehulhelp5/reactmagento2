<script>
document.addEventListener("DOMContentLoaded", function () {
    // Select all tab titles
    const tabTitles = document.querySelectorAll(".data.item.title");

    tabTitles.forEach(title => {
        title.addEventListener("click", function () {
            const targetId = this.querySelector("a").getAttribute("href").replace("#", "");
            const targetContent = document.getElementById(targetId);

            if (!targetContent) return;

            // Hide all other tab contents and remove active class from other titles
            document.querySelectorAll(".data.item.content").forEach(content => {
                content.style.display = "none";
            });
            document.querySelectorAll(".data.item.title").forEach(tab => {
                tab.classList.remove("active");
            });

            // Toggle the selected tab content
            targetContent.style.display = "block";
            this.classList.add("active");
        });
    });
});

</script>

<script>

const popup = document.getElementById('popup');

function attachClickEvent(){
    // Select the image and popup elements
    const img = document.getElementById('m-img');
    const popupImg = document.getElementById('popup-img');

    // Click event to show full-size image
    img.addEventListener('click', function () {
        const img = document.getElementById('mImg');
        const fullSrc = img.getAttribute('src-full'); // Get full-size image URL
        popupImg.src = fullSrc;
        popup.style.display = 'flex'; // Show popup
    });
}
    // Function to close popup
    function closePopup() {
        if(popup){
            popup.style.display = 'none';
        }
    }

    // Close popup when clicking outside the image
    popup.addEventListener('click', function (event) {
        if (event.target === popup) {
            closePopup();
        }
    });

    // Listen for ESC key press
document.addEventListener('keydown', function (event) {
    if (event.key === "Escape" || event.key === "Esc") { // Check for ESC key
        closePopup();
    }
});

attachClickEvent();

</script>
