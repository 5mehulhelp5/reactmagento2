<ul>
    <li><a href="<?=$block->getBaseUrl();?>">Home</a></li>

    <?php foreach ($categoryPath as $category): ?>
        <li>
            <a href="<?=$block->escapeUrl($category['link']);?>">
                <?=$block->escapeHtml($category['label']);?>
            </a>
        </li>
    <?php endforeach; ?>

    <li><?=$block->escapeHtml($product->getName());?></li>
</ul>
