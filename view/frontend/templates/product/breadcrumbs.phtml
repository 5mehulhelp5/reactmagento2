 */
/** @var \Magento\Theme\Block\Html\Breadcrumbs $block */
/** @var \Magento\Catalog\ViewModel\Product\Breadcrumbs $viewModel */
$startTime = microtime(true);

$viewModel = $block->getData('viewModel');
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$product = $objectManager->get('Magento\Framework\Registry')->registry('current_product');
$collection = $objectManager->get(Collection::class);
$categoryHelper = $objectManager->get(\Magento\Catalog\Helper\Data::class);
$categoryIds = $product->getCategoryIds();

$categoryPath = [];

if (!empty($categoryIds)) {

    $categoryRepository = $objectManager->get(\Magento\Catalog\Model\CategoryRepository::class);

    // Get the category with the **deepest path** (most specific category)
    $maxLevel = 0;
    $selectedCategory = null;

    $categories = $collection->addAttributeToSelect('entity_id')
        ->addFieldToFilter('entity_id', ['in' => $categoryIds])->getItems();

    // Stupid Adobe doesn't have getList for categories for prefetch...
    //$categoryList = $categoryRepository->getList($searchCriteria)->getItems();

    foreach ($categories as $category) {
        try {
            if ($category->getLevel() > $maxLevel) {
                $maxLevel = $category->getLevel();
                $selectedCategory = $category;
            }
        } catch (\Magento\Framework\Exception\NoSuchEntityException $e) {
            continue;
        }
    }

    // If we have a selected category, build its breadcrumb path
    if ($selectedCategory) {
        $pathIds = explode('/', $selectedCategory->getPath()); // Category path

        foreach ($pathIds as $pathId) {
            if ($pathId > 1) { // Ignore root category (ID:1)
                try {
                    $parentCategory = $categoryRepository->get($pathId);
                    $categoryPath[] = [
                        'label' => $parentCategory->getName(),
                        'link' => $parentCategory->getUrl(),
                    ];
                } catch (\Magento\Framework\Exception\NoSuchEntityException $e) {
                    continue;
                }
            }
        }
    }
}

$endTime = microtime(true);
$time = $endTime - $startTime;

// Regularly: 4-10ms.
//header("Server-Timing: x-mag-bread;dur=" . number_format($time * 1000, 2), false);

unset($categoryPath[0]);
?>
