<script>
// Bare minimum cart functionality
document.addEventListener('DOMContentLoaded', function() {
    // Remove href from all showcart elements
    var showcartElements = document.querySelectorAll('.action.showcart');
    showcartElements.forEach(function(element) {
        element.removeAttribute('href');
    });
    
    // Listen for cart button clicks
    document.addEventListener('click', function(e) {
        if (e.target.closest('.action.showcart')) {
            e.preventDefault();
            toggleCart();
        }
        
        // Close cart on close button click
        if (e.target.closest('#btn-minicart-close')) {
            e.preventDefault();
            hideCart();
        }
    });
    
    function toggleCart() {
        var minicartBlock = document.querySelector('.block.block-minicart');
        if (minicartBlock && minicartBlock.style.display === 'block') {
            // Cart is open, close it
            hideCart();
        } else {
            // Cart is closed, open it
            showCart();
        }
    }
    
    function showCart() {
        // Check localStorage for Magento cache storage
        var mageCacheStorage = {};
        try {
            var cachedData = localStorage.getItem('mage-cache-storage');
            if (cachedData) {
                mageCacheStorage = JSON.parse(cachedData);
            }
        } catch (e) {
            console.log('No cached data found in localStorage');
        }
        
        var cachedCartData = mageCacheStorage.cart;
        
        // Use cached data if available
        if (cachedCartData && cachedCartData.html_cart) {
            console.log('Cached cart data found in localStorage');
            displayCart(cachedCartData);
            return;
        }
        
        // Fetch fresh cart data from server
        fetch('/customer/section/load/?sections=cart')
            .then(response => response.json())
            .then(data => {
                displayCart(data.cart);
            })
            .catch(error => {
                console.error('Failed to load cart:', error);
            });
    }
    
    function displayCart(cartData) {
        // Insert cart HTML into minicart content wrapper
        var contentWrapper = document.getElementById('minicart-content-wrapper');
        if (contentWrapper && cartData && cartData.html_cart) {
            contentWrapper.innerHTML = cartData.html_cart;
        }
        
        // Show the minicart block
        var minicartBlock = document.querySelector('.block.block-minicart');
        if (minicartBlock) {
            minicartBlock.style.display = 'block';
        }
    }
    
    function hideCart() {
        // Hide the minicart block
        var minicartBlock = document.querySelector('.block.block-minicart');
        if (minicartBlock) {
            minicartBlock.style.display = 'none';
        }
    }

});
</script>
