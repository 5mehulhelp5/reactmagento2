<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" template="React_React::react-component.phtml" ifconfig="react_vue_config/react/enable"/>
            <block class="Magento\Framework\View\Element\Template" template="React_React::vue-component.phtml" ifconfig="react_vue_config/vue/enable"/>
        </referenceContainer>
        <referenceContainer name="head.additional">
            <block class="React\React\Template"
                   name="react-luma.head.block"
                   template="React_React::react-header.phtml"/>
            <block class="React\React\Template"
                   name="react-luma.css.head.block"
                   after="react-luma.head.block"
                   template="React_React::react-header-css.phtml"/>
        </referenceContainer>
        <referenceContainer name="footer">
            <block class="React\React\Template"
                name="react-luma.css.footer.block"
                before="react-luma.footer.block"
                template="React_React::react-footer-css.phtml"/>
            <block class="React\React\Template"
                name="react-luma.footer.block"
                template="React_React::react-footer.phtml">
                <arguments>
                    <argument name="minify" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="navigation.sections">
            <block class="Magento\Framework\View\Element\Template" name="store.link2" group="navigation-sections" template="React_React::topmenu-account.phtml">
                    <arguments>
                        <argument name="title" translate="true" xsi:type="string">Account</argument>
                    </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="store.links" remove="true" />
        <referenceBlock name="logo">
            <arguments>
                <argument name="template" xsi:type="string">React_React::html/header/logo.phtml</argument>
                <argument name="logo_file_name" xsi:type="string">images/logo.svg</argument>
                <argument name="logo_alt" xsi:type="string">React-Luma</argument>
                <argument name="logo_width" xsi:type="string">150</argument>
                <argument name="logo_height" xsi:type="string">50</argument>
            </arguments>
        </referenceBlock>
        <!-- Override wishlist sidebar template to remove Knockout.js -->
        <referenceBlock name="wishlist_sidebar" template="React_React::sidebar.phtml"/>
        <!-- Override compare sidebar template to remove Knockout.js -->
        <referenceBlock name="catalog.compare.sidebar" template="React_React::product/compare/sidebar.phtml"/>
    </body>
</page>
