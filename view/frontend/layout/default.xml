<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" template="React_React::react-component.phtml" ifconfig="react_vue_config/react/enable"/>
            <block class="Magento\Framework\View\Element\Template" template="React_React::vue-component.phtml" ifconfig="react_vue_config/vue/enable"/>
        </referenceContainer>
        <referenceContainer name="footer">
                <block class="React\React\Template"
                name="react-luma.footer.block"
                template="React_React::react-footer.phtml"/>
        </referenceContainer>
        <referenceContainer name="head.additional">
            <block class="React\React\Template"
                   name="react-luma.head.block"
                   template="React_React::react-header.phtml"/>
        </referenceContainer>
        <referenceBlock name="navigation.sections">
            <block class="Magento\Framework\View\Element\Template" name="store.link2" group="navigation-sections" template="React_React::topmenu-account.phtml">
                    <arguments>
                        <argument name="title" translate="true" xsi:type="string">Account</argument>
                    </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="store.links" remove="true" />
    </body>
</page>
